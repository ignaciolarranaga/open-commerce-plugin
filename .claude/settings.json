{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/eval-gate.sh\"",
            "timeout": 3600,
            "statusMessage": "Running plugin evals before push…"
          }
        ]
      }
    ]
  }
}
